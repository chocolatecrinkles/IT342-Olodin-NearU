<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F5F5"
    android:orientation="vertical">

    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/nearu_blue_header"
        app:title="Your Listings"
        app:titleTextColor="#333333"/>

    <com.google.android.material.tabs.TabLayout
        android:id="@+id/tabLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@android:color/white"
        app:tabIndicatorColor="@color/nearu_dark_blue"
        app:tabSelectedTextColor="@color/nearu_dark_blue"
        app:tabTextColor="@color/nearu_text_gray"
        app:tabGravity="fill"
        app:tabMode="fixed"
        app:tabIndicatorHeight="3dp"/>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/ownerListingsRecyclerView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:padding="12dp"
        android:clipToPadding="false"/>

</LinearLayout>